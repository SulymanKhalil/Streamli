# Create .env.local from this file. Never expose these values in client-side code.
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_EMAIL=hello@your-verified-domain.com
RESEND_FROM_EMAIL=Streamli <hello@your-verified-domain.com>
# Optional. A Calendly event URL, such as https://calendly.com/your-team/intro
NEXT_PUBLIC_CALENDLY_URL=
# Public canonical domain, used by metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
